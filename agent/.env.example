PORT=8402
PUBLIC_URL=https://factura.example.com
DATA_DIR=./data

# Celo mainnet (the hackathon counts mainnet only)
CHAIN=celo
# RPC_URL=https://forno.celo.org
AGENT_PRIVATE_KEY=0x...
# Set after `npm run deploy:ledger`
LEDGER_ADDRESS=

# ERC-8021 attribution code issued at hackathon enrollment
ATTRIBUTION_CODE=
# ERC-8004 agent id, set after `npm run register:agent`
AGENT_ID=

# Celo hosted x402 facilitator key (x402.celo.org dashboard)
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_API_KEY=

# Textile FX. Optional partner key; without one the agent signs a TakerControl proof.
TEXTILE_API_URL=https://api.textilecredit.com/v2
TEXTILE_API_KEY=
MAX_FX_DEVIATION_BPS=150

# buy account holding the agent key (see `npm run buy:import`) and a daily spend cap
BUY_ACCOUNT=factura
BUY_DAILY_BUDGET_USD=2

# Bearer token for the freelancer REST API
API_TOKEN=change-me-to-a-long-random-string
